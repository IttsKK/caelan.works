---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import PhotoStrip from "../components/PhotoStrip.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { featured } from "../data/photos";
import { projects } from "../data/projects";
import { siteMeta } from "../config/site";
import { withLinks } from "../lib/links";

/** App icons by where a link to the app might go (its site or its write-up), for the now line. */
const icons = new Map<string, ImageMetadata>();
for (const project of projects) {
  if (!project.icon) continue;
  if (project.href) icons.set(project.href, project.icon);
  if (project.app) icons.set(`/apps/${project.app}`, project.icon);
}
---

<BaseLayout>
  <section class="hero wrap" data-hero>
    <div class="hero__intro">
      <h1 class="hero__name">{siteMeta.name}</h1>
      <p class="hero__line">{siteMeta.intro}</p>
      {
        siteMeta.now && (
          <p class="hero__now">
            {withLinks(siteMeta.now).map((part) => {
              if (!part.href) return part.text;
              const icon = icons.get(part.href);
              const image = icon && <Image class="app-icon" src={icon} alt="" widths={[24, 48]} sizes="24px" loading="eager" />;
              return <a href={part.href}>{image}{part.text}</a>;
            })}
          </p>
        )
      }
      <nav class="hero__socials" aria-label="Social links">
        <a href="https://www.instagram.com/caelan.redekopp/" rel="me">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" /></svg>
          Instagram
        </a>
        <a href="https://github.com/ittskk" rel="me">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4 1-4-2-6-2m12 5v-4a3.5 3.5 0 0 0-1-2.7c3.3-.4 6.8-1.6 6.8-7.3A5.7 5.7 0 0 0 19.3 4a5.3 5.3 0 0 0-.1-4s-1.3-.4-4.2 1.5a14.5 14.5 0 0 0-7.6 0C4.5-.4 3.2 0 3.2 0a5.3 5.3 0 0 0-.1 4 5.7 5.7 0 0 0-1.5 4c0 5.7 3.5 6.9 6.8 7.3A3.5 3.5 0 0 0 7.4 18v4" transform="translate(1 1) scale(.91)" /></svg>
          GitHub
        </a>
        <a href="https://linkedin.com/in/caelan-redekopp" rel="me">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M7 10v7m0-10v.01M11 17v-7m0 3a3 3 0 0 1 6 0v4" /></svg>
          LinkedIn
        </a>
      </nav>
    </div>

    <div class="hero__refs">
      <h2 class="hero__label">Selected work</h2>
      <ul>
        {
          projects.map((project, i) => (
            <li>
              <a class="ref" href={`/work/${project.slug}`} data-ref={i}>
                <span class="ref__title">{project.title}</span>
                <span class="ref__year">{project.year}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__preview" aria-hidden="true">
      {
        projects.map((project, i) => (
          <Image src={project.cover.src} alt="" widths={[480, 960]} sizes="420px" data-ref={i} />
        ))
      }
    </div>
  </section>

  <section class="section wrap" id="work" aria-labelledby="work-title">
    <h2 class="section__title" id="work-title">Work</h2>
    <ul class="work">
      {
        projects.map((project) => (
          <li class:list={[project.featured && "work--featured"]}>
            <a class="work__item" href={`/work/${project.slug}`}>
              <div class="shot">
                <Image
                  src={project.cover.src}
                  alt={project.cover.alt}
                  widths={[640, 960, 1280, 1920, 2560]}
                  sizes={
                    project.featured
                      ? "(min-width: 1360px) 1264px, 100vw"
                      : "(min-width: 1360px) 632px, (min-width: 760px) 50vw, 100vw"
                  }
                  loading={project.featured ? "eager" : "lazy"}
                  quality={90}
                />
              </div>
              <div class="work__caption">
                <h3 class="work__title">{project.title}</h3>
                <p class="work__year">{project.year}</p>
                <p class="work__summary">{project.summary}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap" id="photography" aria-labelledby="photography-title">
    <div class="section__head">
      <h2 class="section__title" id="photography-title">Photography</h2>
      <a href="/photography">Open the board</a>
    </div>
    <PhotoStrip files={featured} />
  </section>

  <section class="section wrap about" id="about" aria-labelledby="about-title">
    <h2 class="section__title" id="about-title">About</h2>
    <div class="about__body">
      {
        siteMeta.about.map((paragraph) => (
          <p>{withLinks(paragraph).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}</p>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Hovering a title in the hero shows that site, trailing the pointer.
  (() => {
    const hero = document.querySelector("[data-hero]");
    const preview = hero && hero.querySelector(".hero__preview");
    if (!preview || !window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;

    const images = [...preview.querySelectorAll("img")];
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let x = 0;
    let y = 0;
    let tx = 0;
    let ty = 0;
    let raf = 0;

    const place = () => {
      x += (tx - x) * (reduced ? 1 : 0.18);
      y += (ty - y) * (reduced ? 1 : 0.18);
      preview.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(place) : 0;
    };

    // Sit above the pointer and never over the list itself.
    const refs = hero.querySelector(".hero__refs");
    const follow = (event) => {
      const box = hero.getBoundingClientRect();
      const limit = refs.getBoundingClientRect().left - box.left - preview.offsetWidth - 32;
      tx = Math.min(event.clientX - box.left - preview.offsetWidth / 2, limit);
      ty = event.clientY - box.top - preview.offsetHeight - 24;
      if (!raf) raf = requestAnimationFrame(place);
    };

    hero.querySelectorAll(".ref").forEach((ref) => {
      ref.addEventListener("pointerenter", (event) => {
        images.forEach((img) => img.classList.toggle("is-active", img.dataset.ref === ref.dataset.ref));
        if (!preview.classList.contains("is-visible")) {
          follow(event);
          x = tx;
          y = ty;
          place();
        }
        preview.classList.add("is-visible");
      });
      ref.addEventListener("pointermove", follow);
      ref.addEventListener("pointerleave", () => preview.classList.remove("is-visible"));
    });
  })();
</script>
