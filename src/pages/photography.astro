---
import ContactBlock from "../components/ContactBlock.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { photoSets } from "../data/photos";
import { siteMeta } from "../config/site";

const description = "Photography — personal work and sets, by Caelan Redekopp.";
---

<BaseLayout title={`Photography — ${siteMeta.name}`} description={description}>
  <section class="page-intro">
    <div class="frame">
      <h1 class="page-intro__title">Photography</h1>
      <p class="page-intro__lead">
        Personal work, mostly. I shoot to slow down and pay attention, and the
        sets here go up as I finish editing them.
      </p>
    </div>
  </section>
  <section class="section" id="sets">
    <div class="frame section__inner">
      <p class="section__label">Sets</p>
      <div class="section__body">
        <PhotoGrid sets={photoSets} />
      </div>
    </div>
  </section>
  <ContactBlock />
</BaseLayout>
