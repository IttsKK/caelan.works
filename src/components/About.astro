---
import { siteMeta } from "../config/site";

/** A ruled list, not a row of feature cards. */
const practice = [
  {
    term: "Websites",
    def: "Marketing sites and small web apps. Fast, accessible, and built to be edited later without me.",
  },
  {
    term: "Product & tools",
    def: "Dashboards, integrations, and the workflow software behind a small team's day.",
  },
  {
    term: "Photographs",
    def: "Available for shoots, and slowly putting a proper set of personal work online.",
  },
];
---

<section class="section" id="about">
  <div class="frame section__inner">
    <p class="section__label">About</p>
    <div class="section__body">
      <div class="prose">
        {siteMeta.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <ul class="practice">
        {
          practice.map((item) => (
            <li>
              <span class="practice__term">{item.term}</span>
              <span class="practice__def">{item.def}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
