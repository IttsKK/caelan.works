---
import type { WorkEntry } from "../types/site";

interface Props {
  entries: WorkEntry[];
  label?: string;
  more?: { label: string; href: string };
  id?: string;
}

const { entries, label = "Work", more, id = "work" } = Astro.props;

const kindLabels = {
  web: "Website",
  product: "Product",
  tool: "Tool",
  robotics: "Robotics",
} as const;

const statusLabels = {
  active: "in progress",
  ongoing: "ongoing",
  shipped: "shipped",
  archive: "archive",
} as const;

/** One italic line of metadata rather than a row of tags. */
const metaLine = (entry: WorkEntry) =>
  [
    kindLabels[entry.kind],
    entry.role.toLowerCase(),
    statusLabels[entry.status],
    entry.note?.toLowerCase(),
    entry.stack.join(", "),
  ]
    .filter(Boolean)
    .join(" · ");
---

<section class="section" id={id}>
  <div class="frame section__inner">
    <p class="section__label">{label}</p>
    <div class="section__body">
      <ol class="work-list">
        {
          entries.map((entry) => {
            const Wrapper = entry.href ? "a" : "div";
            return (
              <li class="work-item">
                <Wrapper
                  class="work-item__link"
                  href={entry.href}
                  target={entry.href ? "_blank" : undefined}
                  rel={entry.href ? "noreferrer" : undefined}
                >
                  <p class="work-item__number" aria-hidden="true" />
                  <div class="work-item__main">
                    <div class="work-item__head">
                      <h3 class="work-item__title">{entry.title}</h3>
                      <p class="work-item__period">{entry.period}</p>
                    </div>
                    <p class="work-item__summary">{entry.summary}</p>
                    <p class="work-item__meta">{metaLine(entry)}</p>
                  </div>
                </Wrapper>
              </li>
            );
          })
        }
      </ol>
      {
        more && (
          <p class="section__more">
            <a href={more.href}>{more.label}</a>
          </p>
        )
      }
    </div>
  </div>
</section>
